# ─── Demo Mode ───────────────────────────────────────────────────────────────
# When DEMO_MODE=true, ALL external API calls are replaced with static mock data.
# No OpenAI, Supabase Storage, Apple, Google Play, or AppFollow keys required.
# Only a PostgreSQL database is needed (use Docker below).
DEMO_MODE="true"

# ─── Database (local Docker PostgreSQL) ──────────────────────────────────────
# Start with: docker-compose up -d
DATABASE_URL="postgresql://launchos:launchos_dev@localhost:5432/launchos"
DIRECT_URL="postgresql://launchos:launchos_dev@localhost:5432/launchos"

# ─── Supabase (not needed in demo — Storage is skipped) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://placeholder.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="demo_anon_key"
SUPABASE_SERVICE_ROLE_KEY="demo_service_role_key"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="demo-secret-change-me-in-production-32chars"

# ─── OpenAI (not called in demo mode) ────────────────────────────────────────
OPENAI_API_KEY="sk-demo-not-used"

# ─── Stripe (not called in demo mode) ────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_demo_not_used"
STRIPE_PUBLISHABLE_KEY="pk_test_demo_not_used"
STRIPE_WEBHOOK_SECRET="whsec_demo_not_used"
STRIPE_STARTER_PRICE_ID="price_demo_starter"
STRIPE_GROWTH_PRICE_ID="price_demo_growth"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Redis (optional — in-memory fallback used when not set) ─────────────────
REDIS_URL="redis://localhost:6379"
