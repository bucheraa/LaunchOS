# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Local zero-infrastructure demo mode.
# No database server, Supabase, Stripe, Redis, Apple, Google Play, or OpenAI access is required.
# The app auto-signs into a fixed demo workspace and stores demo changes in memory.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# ─── Database (dummy values for Prisma boot only) ────────────────────────────
# These are intentionally not used in local demo mode.
DATABASE_URL="postgresql://demo:demo@127.0.0.1:5432/launchos_demo"
DIRECT_URL="postgresql://demo:demo@127.0.0.1:5432/launchos_demo"

# ─── Supabase (not needed in demo — Storage is skipped) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://placeholder.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="demo_anon_key"
SUPABASE_SERVICE_ROLE_KEY="demo_service_role_key"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="demo-secret-change-me-in-production-32chars"

# ─── OpenAI (not called in demo mode) ────────────────────────────────────────
OPENAI_API_KEY="sk-demo-not-used"

# ─── Stripe (not called in demo mode) ────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_demo_not_used"
STRIPE_PUBLISHABLE_KEY="pk_test_demo_not_used"
STRIPE_WEBHOOK_SECRET="whsec_demo_not_used"
STRIPE_STARTER_PRICE_ID="price_demo_starter"
STRIPE_GROWTH_PRICE_ID="price_demo_growth"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Redis (optional — in-memory fallback used when not set) ─────────────────
REDIS_URL="redis://localhost:6379"
