# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/database
# Use the "Transaction" pooler URL for serverless (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the direct URL for migrations only
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ─── OAuth (optional) ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Get from: https://dashboard.stripe.com/webhooks (add endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create products in Stripe Dashboard → Products → Add product
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_GROWTH_PRICE_ID="price_..."

# ─── Apple App Store Connect ─────────────────────────────────────────────────
# Get from: https://appstoreconnect.apple.com/access/integrations/api
# Create an API key with "App Manager" or "Developer" access
APPLE_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
APPLE_KEY_ID="XXXXXXXXXX"
# Paste the full private key content (the .p8 file content) — keep newlines as \n
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGHAgEA...\n-----END PRIVATE KEY-----"

# ─── Google Play Developer ───────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → IAM → Service Accounts
# Create service account with "Android Publisher" API access, download JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL="launchos@your-project.iam.gserviceaccount.com"
# Paste the private key from the JSON key file — keep \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"

# ─── AppFollow (Keyword Research) ─────────────────────────────────────────────
# Get from: https://appfollow.io/api (paid plan required)
# Leave empty to use iTunes autocomplete as free fallback
APPFOLLOW_API_KEY=""

# ─── Redis (BullMQ job queue — optional for background jobs) ─────────────────
# Use Upstash Redis for Vercel: https://upstash.com/
REDIS_URL="redis://localhost:6379"
# Or Upstash:
# REDIS_URL="rediss://default:xxx@xxx.upstash.io:6380"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
